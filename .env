# ── Data ──────────────────────────────────────────────────────────────────────
# Dataset source: folder | csv
DATASET_SOURCE=csv

# Used when DATASET_SOURCE=csv
TRAIN_CSV=data_train/comp/v1_train_English.csv

# Used when DATASET_SOURCE=folder
DATA_ROOT=data_train

K_FACES=6
MAX_AUDIO_SEC=18.0

# ── Audio preprocessing ───────────────────────────────────────────────────────
# Voice Activity Detection (VAD): removes silence and non-speech segments.
# Uses energy-based detection to trim silent parts before training.
USE_VAD=false
# Energy threshold in dB below max (lower = more aggressive trimming)
# Typical range: -50 to -30 dB. Increase if removing too much speech.
VAD_THRESHOLD_DB=-35.0

# ── Model ─────────────────────────────────────────────────────────────────────
# Face encoder:  vit_base | vit_large | resnet50
FACE_ENCODER=vit_large
# Audio encoder: wavlm_base | wavlm_large | wav2vec2 | w2v_bert_2 | unispeech_sv
AUDIO_ENCODER=w2v_bert_2
EMBED_DIM=768

# Fusion type: late | cross_attn | gated
FUSION_TYPE=cross_attn
# Number of heads used only by cross_attn fusion
CROSS_ATTN_HEADS=6

# ── Modality dropout ──────────────────────────────────────────────────────────
# Fraction of steps where the face is replaced with a learnable [MASK] token.
# 0.3 = 30 % audio-only steps  →  trains P4/P6 robustness
MASK_PROB=0.3

# ── LASE (optional) ───────────────────────────────────────────────────────────
# Language-Adversarial Speaker Encoding is useful only when multi-language
# training data is present (e.g., both English and Urdu in training batches).
ENABLE_LASE=false
# Comma-separated language keywords searched in wav file paths.
# Used only when ENABLE_LASE=true.
LANG_KEYWORDS=english,urdu
# Number of languages for the LASE adversarial head. Always read from .env (default 2).
NUM_LANGUAGES=2
# Weight of adversarial language CE term in total loss.
LAMBDA_LANG=0.2
# Gradient reversal strength for adversarial language classifier.
LANG_GRL_LAMBDA=1.0
# --------------------------------------------------------------------------------------

# ── Training ──────────────────────────────────────────────────────────────────
EPOCHS=100
BATCH_SIZE=52
LR=1e-4
WEIGHT_DECAY=1e-4
FREEZE_ENCODERS_EPOCHS=15

# ── Loss weights ──────────────────────────────────────────────────────────────
LAMBDA_CON=0.2
LAMBDA_ORTH=0.1

# ── Runtime ───────────────────────────────────────────────────────────────────
NUM_WORKERS=2
# DEVICE=cuda   # auto-detected if unset
SEED=42

# ── Checkpoints ──────────────────────────────────────────────────────────────
OUTPUT_DIR=checkpoints/exp1
# Save a periodic checkpoint every N epochs (e.g. epoch_0010.pt, epoch_0020.pt)
CHECKPOINT_INTERVAL=10
# Resume training from a saved checkpoint. Leave empty to train from scratch.
# Examples: checkpoints/last.pt  |  checkpoints/epoch_0030.pt  |  checkpoints/best.pt
RESUME_FROM=checkpoints/exp1/best.pt
# Restore optimizer/scheduler state when resuming. Can cause CUDA OOM on large runs.
# false = memory-safe resume (model weights + epoch + best_acc only).
RESUME_OPTIMIZER=false
# ── Validation & TensorBoard ─────────────────────────────────────────────────
# Fraction of training data held out for validation (0 = disabled)
# VAL_SPLIT=0.1
# Directory where TensorBoard event files are written
# Launch with:  tensorboard --logdir runs/
TENSORBOARD_DIR=runs/exp1
# Write batch-level TensorBoard scalars every N training steps
TB_LOG_EVERY=5

# ── Memory optimisation ───────────────────────────────────────────────────────
# USE_AMP: fp16 mixed-precision — halves activation + gradient-buffer memory
USE_AMP=false
# GRAD_CHECKPOINT: recompute activations during backward instead of caching them
# saves ~50% activation RAM at ~25% extra compute
GRAD_CHECKPOINT=true
# GRAD_ACCUM_STEPS: accumulate gradients N steps before the weight update
# effective_batch = BATCH_SIZE × GRAD_ACCUM_STEPS
GRAD_ACCUM_STEPS=1
# CPU_OFFLOAD_OPTIM: keep Adam m/v momentum states in CPU RAM; load to GPU only
# during the weight-update step — saves ~2× model-size in GPU RAM
# note: adds H2D/D2H transfer overhead per optimiser step
CPU_OFFLOAD_OPTIM=true

# ── Evaluation (scripts/eval_p3.py) ─────────────────────────────────────────
# Checkpoint for evaluation. Leave empty to fallback to checkpoints/best.pt
EVAL_CHECKPOINT=checkpoints/exp1/epoch_0040.pt
# Test set root containing faces/<lang> and voices/<lang>
DATA_TEST_ROOT=test/val/v1
# Language subset to evaluate: English | Urdu
EVAL_SET=dev
EVAL_LANG=English
EVAL_P56_LANG=Urdu
# Output CSV filename written under OUTPUT_DIR
# EVAL_OUTPUT_CSV=checkpoints/submission_v1_dev_English_English.csv
# TensorBoard directory for evaluation scalars
EVAL_TENSORBOARD_DIR=runs/eval
# Optional labels CSV for local P3/P4 accuracy/loss computation
# Must include: key + one of [label, speaker, speaker_id, target, p3]
EVAL_LABELS_CSV=

# ── Unified Evaluation (scripts/eval_all.py) ────────────────────────────────
# Runs P3/P4 (same-language) + P5/P6 (cross-language) in one execution.
# If empty, it falls back to EVAL_CHECKPOINT, then checkpoints/best.pt.
EVAL_ALL_CHECKPOINT=checkpoints/exp1/epoch_0040.pt

# Language folders under Data_Test/{faces,voices}/
EVAL_LANG_SAME=English
EVAL_LANG_CROSS=Urdu

# Challenge-format output CSV names
# If filename only: written under OUTPUT_DIR
# If relative path with dirs: resolved from repo root
EVAL_OUTPUT_EN_EN=submission_v1_dev_English_English.csv
EVAL_OUTPUT_EN_UR=submission_v1_dev_English_Urdu.csv

# TensorBoard directory for unified evaluation scalars
EVAL_ALL_TENSORBOARD_DIR=runs/eval_all

# Optional local labels (for computing local accuracy/loss only)
# same-language labels: key + one of [label,speaker,speaker_id,target,p3]
# cross-language labels: key + one of [label,speaker,speaker_id,target,p5]
EVAL_LABELS_SAME_CSV=
EVAL_LABELS_CROSS_CSV=

# ── English training-set evaluation (scripts/eval_english.py) ───────────────
# Input CSV to score locally and annotate with a pred column.
EVAL_ENGLISH_CSV=data_train/comp/v1_train_English.csv
# Output CSV path. Leave empty to overwrite EVAL_ENGLISH_CSV in place.
EVAL_ENGLISH_OUTPUT_CSV=
# Checkpoint used for this local evaluation.
EVAL_ENGLISH_CHECKPOINT=checkpoints/exp2/epoch_0050.pt
